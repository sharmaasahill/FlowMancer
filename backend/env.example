# FlowMancer backend settings. Copy to .env:  cp env.example .env
# Only GEMINI_API_KEY is required. Everything else has a working default.

DEBUG=True

# ---------- AI ----------
# "gemini" (Google, free tier) or "ollama" (local, offline)
AI_PROVIDER=gemini
# Free key: https://aistudio.google.com  ->  Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Used automatically when the main model is busy or rate-limited (empty = none)
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Last resort: the local Ollama model, if Gemini is unreachable (needs the Ollama app)
OLLAMA_FALLBACK=false
OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# ---------- Optional integrations (leave empty to skip) ----------
# Slack Incoming Webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
# HubSpot Private App token with crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=
# Default outbound webhook (Zapier Catch Hook, n8n Webhook node, Make...)
WEBHOOK_URL=
# Inbox. Gmail: imap.gmail.com + an App Password. Outlook: outlook.office365.com
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
# If set, the public form/webhook triggers require ?secret=... or the X-FlowMancer-Secret header
TRIGGER_SECRET=

# ---------- Advanced (defaults shown) ----------
# DATABASE_URL=sqlite:///./flowmancer.db
# CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
# RESEARCH_ENABLED=true          # sends company name + email domain to DuckDuckGo
# HOT_LEAD_THRESHOLD=80
# DOCUMENT_APPROVAL_AMOUNT=1000
# IMAP_DRAFTS_FOLDER=[Gmail]/Drafts   # Outlook: Drafts
# INBOX_POLL_SECONDS=0               # auto-check the inbox every N seconds
