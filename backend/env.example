# ---------- Application ----------
APP_NAME=FlowMancer
DEBUG=True
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
HOST=0.0.0.0
PORT=8000

# SQLite for local dev; postgresql://user:pass@host:5432/db in production
DATABASE_URL=sqlite:///./flowmancer.db
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# ---------- AI ----------
# "ollama" (free, local) or "openai"
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_NUM_CTX=8192
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- Lead research ----------
# Sends company name / email domain to DuckDuckGo and fetches the company website
RESEARCH_ENABLED=true
RESEARCH_MAX_RESULTS=5

# ---------- Knowledge base ----------
KNOWLEDGE_PATH=./knowledge_data

# ---------- Business rules ----------
HOT_LEAD_THRESHOLD=80
DOCUMENT_APPROVAL_AMOUNT=1000

# ---------- Inbox (IMAP) ----------
# Gmail: imap.gmail.com + an App Password (Google Account > Security > App passwords)
# Outlook: outlook.office365.com, IMAP_DRAFTS_FOLDER=Drafts
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_DRAFTS_FOLDER=[Gmail]/Drafts
# Seconds between automatic polls; 0 = only when you click "Check inbox"
INBOX_POLL_SECONDS=0
INBOX_MAX_PER_POLL=10

# ---------- Actions ----------
# Slack Incoming Webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
# HubSpot Private App token with crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=
# Default outbound webhook (Zapier Catch Hook, n8n Webhook node, Make...)
ZAPIER_WEBHOOK_URL=

# ---------- Triggers ----------
# If set, /api/triggers/form and /api/triggers/webhook/* require ?secret=... or X-FlowMancer-Secret
TRIGGER_SECRET=

MAX_UPLOAD_MB=10
