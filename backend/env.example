# FlowMancer backend settings. Copy to .env:  cp env.example .env
# Only GEMINI_API_KEY is required. Everything else has a working default.

DEBUG=True

# ---------- AI ----------
# "gemini" (Google, free tier) or "ollama" (local, offline)
AI_PROVIDER=gemini
# Free key: https://aistudio.google.com  ->  Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Used automatically when the main model is busy or rate-limited (empty = none)
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Last resort: the local Ollama model, if Gemini is unreachable (needs the Ollama app)
OLLAMA_FALLBACK=false
OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# ---------- Accounts ----------
# Signs login tokens. Empty = one is generated and saved in backend/.flowmancer_secret.
# For Docker or a server, set a random value of 32+ characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# false = only the first account can sign up (close registration after creating yours)
ALLOW_SIGNUPS=true
# Account that owns emails fetched from the inbox below. Empty = the first account created.
INBOX_OWNER_EMAIL=
# "Sign in with Google": a Web application OAuth client ID from https://console.cloud.google.com/auth/clients
# (looks like 1234-abc.apps.googleusercontent.com). Empty = the Google button is hidden.
GOOGLE_CLIENT_ID=
# ACCESS_TOKEN_DAYS=7

# ---------- Optional integrations (leave empty to skip) ----------
# These are shared by every account on this server.
# Slack Incoming Webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
# HubSpot Service Key (or legacy private app token) with crm.objects.contacts.read + write
HUBSPOT_ACCESS_TOKEN=
# Default outbound webhook (Zapier Catch Hook, n8n Webhook node, Make...)
WEBHOOK_URL=
# Inbox. Gmail: imap.gmail.com + a 16-letter App Password (needs 2-Step Verification)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# ---------- Advanced (defaults shown) ----------
# DATABASE_URL=sqlite:///./flowmancer.db        # hosted: postgresql://user:pass@host/db?sslmode=require
# CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]   # add your live frontend URL
# Paid-tier prices (USD per 1M tokens, [input, output]) for the cost estimate on the Usage page
# AI_PRICES={"gemini-3.5-flash-lite": [0.30, 2.50], "gemini-3.1-flash-lite": [0.25, 1.50]}
# RESEARCH_ENABLED=true          # sends company name + email domain to DuckDuckGo
# HOT_LEAD_THRESHOLD=80
# DOCUMENT_APPROVAL_AMOUNT=1000
# IMAP_DRAFTS_FOLDER=[Gmail]/Drafts
# INBOX_POLL_SECONDS=0               # auto-check the inbox every N seconds
