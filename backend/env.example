# Application
APP_NAME=FlowMancer
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Server
HOST=0.0.0.0
PORT=8000

# Database (SQLite for local dev; use postgresql://user:pass@host:5432/db in production)
DATABASE_URL=sqlite:///./flowmancer.db

# AI provider: "ollama" (free, local) or "openai"
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Only needed when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional integrations
N8N_API_URL=
N8N_API_KEY=
ZAPIER_WEBHOOK_URL=

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
